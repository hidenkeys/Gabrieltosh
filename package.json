{
  "name": "gabrieltosh-pos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"node --watch server/index.js\"",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "worker": "node --env-file-if-exists=.env server/worker.js",
    "test": "node --test tests/*.test.js",
    "bootstrap": "node --env-file-if-exists=.env scripts/bootstrap.js",
    "test:postgres": "node scripts/test-postgres.js",
    "format": "prettier --write src server scripts/*.js tests *.json *.ts index.html",
    "preview:local": "node scripts/preview-local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.800.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "pg-mem": "^3.0.5",
    "prettier": "^3.9.10",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
