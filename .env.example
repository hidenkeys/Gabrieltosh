DATABASE_URL=postgres://pos:change-this-password@localhost:5432/gabrieltosh
PORT=3001
HOST=127.0.0.1
ADMIN_ALLOW_REMOTE=false
COOKIE_SECURE=false
PUBLIC_ORIGIN=http://localhost:5173
PRINT_MODE=simulation
RECEIPT_PRINTER=Customer Receipt
LABEL_PRINTER=Cup Stickers
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=14
# Optional encrypted cloud backups (requires pg_dump on PATH)
# BACKUP_ENCRYPTION_KEY=64-hex-characters
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Direct HTTPS for handheld devices; certificates must be trusted on tablets.
# TLS_CERT_PATH=certs/store.pem
# TLS_KEY_PATH=certs/store-key.pem
# HTTPS_PORT=3443
# HTTPS_HOST=0.0.0.0
